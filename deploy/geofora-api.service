# /etc/systemd/system/geofora-api.service
[Unit]
Description=GEOFORA API (FastAPI)
After=network.target

[Service]
User=geofora
WorkingDirectory=/opt/geofora/backend
EnvironmentFile=/etc/geofora.env
# un solo worker: si hubiera varios, la precarga de noticias se ejecutaría varias veces
ExecStart=/opt/geofora/backend/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure

[Install]
WantedBy=multi-user.target
